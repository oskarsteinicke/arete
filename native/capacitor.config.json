{
  "appId": "com.getarete.app",
  "appName": "Arete",
  "webDir": "www",
  "backgroundColor": "#0B0B0B",
  "ios": {
    "contentInset": "always"
  },
  "plugins": {
    "Keyboard": {
      "resize": "native"
    },
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 10000,
      "launchFadeOutDuration": 0,
      "backgroundColor": "#0B0B0B",
      "showSpinner": false
    }
  }
}
